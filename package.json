{
  "name": "web-mcp-assistant",
  "version": "0.1.6",
  "description": "一键部署与管理 Coding Tools MCP、OpenAI Tunnel 和 ChatGPT 接入的 Windows 与 macOS 桌面助手",
  "author": "3169657175",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "icon:build": "node scripts/generate-icon.js",
    "start": "electron .",
    "test": "node --test tests/*.test.js && node scripts/check-source-root-clean.js",
    "audit:prod": "npm audit --omit=dev",
    "dist": "npm run icon:build && npm test && electron-builder",
    "dist:win": "npm run icon:build && npm test && electron-builder --win nsis --x64",
    "dist:mac": "npm run icon:build && npm test && electron-builder --mac dmg zip --x64 --arm64",
    "dist:dir": "npm run icon:build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.gptwebcodex.assistant",
    "productName": "网页 MCP 助手",
    "artifactName": "web-mcp-assistant-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "renderer/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "electron/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "electron/app-icon.png",
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "网页 MCP 助手",
      "installerIcon": "electron/app-icon.ico",
      "uninstallerIcon": "electron/app-icon.ico",
      "installerHeaderIcon": "electron/app-icon.ico",
      "runAfterFinish": true
    }
  }
}
